[
  {{- $countryCode := .Values.jitsi.web.extraConfig.dialinCountryCode }}
  {{- $list := .Values.jitsi.web.extraConfig.dialinPhoneNumbers | default "" | split "," }}
  {{- $len := len $list }}
  {{- $i := 1 }}
  {{- range $key, $phone := $list }}
    {
      "countryCode":"{{ $countryCode }}",
      "tollFree":false,
      "formattedNumber":"{{ $phone }}"
    }{{ if lt $i $len }},{{ end }}
    {{- $i = add $i 1 }}
  {{- end }}
]
