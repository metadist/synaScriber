# Meeting notes (synaScriber) for this openDesk. Generated by ./synascriber; no secrets.
# Copy into your openDesk environment folder, e.g. helmfile/environments/<env>/,
# and keep synascriber-jitsi.yaml where the path below points.
functional:
  authentication:
    oidc:
      clients:
        synaplan:
          clientId: "synaplan"
          name: "Synaplan"
          enabled: true
          protocol: "openid-connect"
          publicClient: false
          clientAuthenticatorType: "client-secret"
          standardFlowEnabled: true
          implicitFlowEnabled: false
          directAccessGrantsEnabled: false
          serviceAccountsEnabled: false
          frontchannelLogout: true
          fullScopeAllowed: true
          rootUrl: "https://synaplan.desk.synaplan.com"
          baseUrl: "https://synaplan.desk.synaplan.com"
          redirectUris:
            - "https://synaplan.desk.synaplan.com/api/v1/auth/keycloak/callback"
          webOrigins:
            - "https://synaplan.desk.synaplan.com"
          attributes:
            post.logout.redirect.uris: "https://synaplan.desk.synaplan.com/"
            use.refresh.tokens: "true"
          defaultClientScopes:
            - "web-origins"
            - "acr"
            - "profile"
            - "roles"
            - "email"
          optionalClientScopes:
            - "offline_access"
          protocolMappers:
            - name: "sub"
              protocol: "openid-connect"
              protocolMapper: "oidc-usermodel-property-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
                user.attribute: "id"
                claim.name: "sub"
                jsonType.label: "String"
            - name: "email"
              protocol: "openid-connect"
              protocolMapper: "oidc-usermodel-property-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
                user.attribute: "email"
                claim.name: "email"
                jsonType.label: "String"
            - name: "full name"
              protocol: "openid-connect"
              protocolMapper: "oidc-full-name-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
            - name: "username"
              protocol: "openid-connect"
              protocolMapper: "oidc-usermodel-property-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
                user.attribute: "username"
                claim.name: "preferred_username"
                jsonType.label: "String"
            - name: "groups"
              protocol: "openid-connect"
              protocolMapper: "oidc-group-membership-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
                claim.name: "groups"
                full.path: "false"
            - name: "synaplan-audience"
              protocol: "openid-connect"
              protocolMapper: "oidc-audience-mapper"
              consentRequired: false
              config:
                id.token.claim: "false"
                access.token.claim: "true"
                included.client.audience: "synaplan"
          secret:
            existingSecret:
              name: "synaplan-oidc-credentials"
              key: "client-secret"
        synascriber:
          clientId: "synascriber"
          name: "Meeting notes (Jitsi button)"
          enabled: true
          protocol: "openid-connect"
          publicClient: true
          standardFlowEnabled: true
          implicitFlowEnabled: false
          directAccessGrantsEnabled: false
          serviceAccountsEnabled: false
          frontchannelLogout: true
          fullScopeAllowed: false
          rootUrl: "https://meet.desk.synaplan.com"
          baseUrl: "https://meet.desk.synaplan.com"
          redirectUris:
            - "https://meet.desk.synaplan.com/static/synascriber-silent.html"
          webOrigins:
            - "https://meet.desk.synaplan.com"
          attributes:
            pkce.code.challenge.method: "S256"
            post.logout.redirect.uris: "+"
          defaultClientScopes:
            - "web-origins"
            - "acr"
            - "profile"
            - "roles"
            - "email"
          optionalClientScopes: []
          protocolMappers:
            - name: "sub"
              protocol: "openid-connect"
              protocolMapper: "oidc-usermodel-property-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
                user.attribute: "id"
                claim.name: "sub"
                jsonType.label: "String"
            - name: "email"
              protocol: "openid-connect"
              protocolMapper: "oidc-usermodel-property-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
                user.attribute: "email"
                claim.name: "email"
                jsonType.label: "String"
            - name: "full name"
              protocol: "openid-connect"
              protocolMapper: "oidc-full-name-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
            - name: "username"
              protocol: "openid-connect"
              protocolMapper: "oidc-usermodel-property-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
                user.attribute: "username"
                claim.name: "preferred_username"
                jsonType.label: "String"
            - name: "groups"
              protocol: "openid-connect"
              protocolMapper: "oidc-group-membership-mapper"
              consentRequired: false
              config:
                id.token.claim: "true"
                access.token.claim: "true"
                userinfo.token.claim: "true"
                claim.name: "groups"
                full.path: "false"
            - name: "synaplan-audience"
              protocol: "openid-connect"
              protocolMapper: "oidc-audience-mapper"
              consentRequired: false
              config:
                id.token.claim: "false"
                access.token.claim: "true"
                included.client.audience: "synaplan"
customization:
  release:
    jitsi:
      synascriber: "/wwwroot/synaScriber/deploy/opendesk/.state/vultr/opendesk/opendesk/synascriber-jitsi.yaml"
