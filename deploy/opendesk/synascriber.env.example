# synaScriber for openDesk — settings.
# Copy to synascriber.env (same folder) and change what you need.
# Everything else (domain, Keycloak, Jitsi, certificates) is read from your cluster.

# --- Where ---------------------------------------------------------------------
# kubectl context of the openDesk cluster. Empty = your current context.
KUBE_CONTEXT=
# Namespace openDesk runs in. Empty = found automatically.
OPENDESK_NAMESPACE=

# --- Speech-to-text (turns meeting audio into text) ----------------------------
# cpu  run the German Whisper server on the cluster's CPUs (fine for trying it out:
#      one or two speakers, captions arrive a few seconds late)
# gpu  run it on an NVIDIA GPU node (real meetings)
# url  use a Whisper server you already run (whisper.cpp "whisper-server"); set STT_URL
STT=cpu
STT_URL=

# --- AI models (optional) ------------------------------------------------------
# Ollama for Synaplan's chat and document search ("What did we decide yesterday?").
# Empty = no models; meeting notes are still written and saved.
OLLAMA_URL=

# --- Meeting notes -------------------------------------------------------------
# Languages people can pick in the meeting (de, en, es, fr, tr) and the default.
NOTES_LANGUAGES=de,en
NOTES_DEFAULT_LANGUAGE=de
# Folder in Synaplan › Sources › Generated where transcripts land.
NOTES_FOLDER=Meetings
NOTES_TIMEZONE=Europe/Berlin
# Live captions while people speak: on, off, or auto (on, except with STT=cpu).
LIVE_CAPTIONS=auto

# --- Advanced (usually leave empty) --------------------------------------------
# Synaplan's address: https://<SYNAPLAN_HOST>.<openDesk domain>
SYNAPLAN_HOST=synaplan
SYNAPLAN_VERSION=5.3.2
# Helm 3 binary (openDesk does not support Helm 4), and helmfile.
HELM=helm
HELMFILE=helmfile
# A local synaplan-charts checkout instead of the pinned version (development).
SYNAPLAN_CHARTS_PATH=
# Owner of the plugin in Synaplan. Empty = Synaplan's first local administrator.
PLUGIN_OWNER_EMAIL=
# Override what the installer detects:
INGRESS_CLASS=
TLS_SECRET=
CERT_ISSUER=
CERT_ISSUER_KIND=
CA_SECRET=
# Collabora for Office previews in Synaplan; "off" to switch off.
COLLABORA_URL=
# openDesk's Jitsi chart, if you mirror charts in a private registry.
JITSI_CHART=
