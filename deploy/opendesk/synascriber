    ok(f"settings: languages {','.join(settings['languages'])}, folder {settings['default_folder']}, "
       f"live captions {'on' if settings['captions'] else 'off'}")
    report_checks({k: v for k, v in checks.items() if k != "jitsi"})


def plugin_api(sh, t, pod, method, path, body=None):
    api_key = secret_value(sh, t["namespace"], "synascriber", "api-key")
    script = ('code=$(curl -s -o /tmp/synascriber.json -w "%{http_code}" -X "$1" -H "Host: $2" -H "Authorization: Bearer $3" '
              '-H "Content-Type: application/json" --data-binary @- "http://127.0.0.1/api/v1/plugins/synascriber$4"); '
              'echo "$code"; cat /tmp/synascriber.json; rm -f /tmp/synascriber.json')
    result = in_synaplan(sh, t["namespace"], pod, "sh", "-c", script, "sh", method, t["synaplanHost"], api_key, path,
                         input_text=json.dumps(body) if body is not None else "")
    code, _, payload = result.stdout.partition("\n")
    if code.strip() != "200":
        raise Stop(f"meeting-notes plugin {method} {path}: HTTP {code.strip()}", payload[:600])
    return json.loads(payload).get("checks", {})


def report_checks(checks):
    labels = {"jitsi": "Jitsi (Prosody module)", "speech": "speech-to-text server", "owner": "plugin owner", "secret": "shared secret"}
    for key, good in checks.items():
        (ok if good else warn)(f"plugin check {labels.get(key, key)}: {'ok' if good else 'NOT OK'}")


