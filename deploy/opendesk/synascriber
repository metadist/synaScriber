# ------------------------------------------------------------------ output


def say(text):
    print(f"\n\033[1m== {text}\033[0m", flush=True)


def ok(text):
    print(f"   ok    {text}", flush=True)


def note(text):
    print(f"   ..    {text}", flush=True)


def warn(text):
    print(f"   \033[33mwarn\033[0m  {text}", flush=True)


class Stop(Exception):
    """A problem the person can fix; message and hint are shown, no traceback."""

    def __init__(self, message, hint=""):
        super().__init__(message)
        self.hint = hint


def ask(question, assume_yes):
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        raise Stop(f"{question} (no terminal to ask)", "Run again with --yes.")
    return input(f"   ??    {question} [y/N] ").strip().lower() in ("y", "yes", "j", "ja")


# ------------------------------------------------------------------ settings


def load_settings(path):
    cfg = dict(DEFAULTS)
    if path.is_file():
        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise Stop(f"{path}:{number}: expected KEY=value, got {line!r}")
            key, value = line.split("=", 1)
            key, value = key.strip().removeprefix("export ").strip(), value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                value = value[1:-1]
            if key not in DEFAULTS:
                raise Stop(f"{path}:{number}: unknown setting {key}", "See synascriber.env.example for the list.")
            cfg[key] = value
    for key in DEFAULTS:
        if os.environ.get(f"SYNASCRIBER_{key}"):
            cfg[key] = os.environ[f"SYNASCRIBER_{key}"]
    cfg["STT"] = cfg["STT"].lower()
    if cfg["STT"] not in ("cpu", "gpu", "url"):
        raise Stop(f"STT must be cpu, gpu or url, not {cfg['STT']!r}")
    if cfg["STT"] == "url" and not cfg["STT_URL"]:
        raise Stop("STT=url needs STT_URL (your speech-to-text server, e.g. http://whisper.example:8080)")
    languages = [x.strip() for x in cfg["NOTES_LANGUAGES"].split(",") if x.strip()]
    if cfg["NOTES_DEFAULT_LANGUAGE"] not in languages:
        raise Stop(f"NOTES_DEFAULT_LANGUAGE {cfg['NOTES_DEFAULT_LANGUAGE']} is not in NOTES_LANGUAGES {cfg['NOTES_LANGUAGES']}")
    return cfg


# ------------------------------------------------------------------ commands


class Shell:
    def __init__(self, cfg):
        self.cfg = cfg
        self.context = cfg["KUBE_CONTEXT"]

    def run(self, args, check=True, input_text=None, capture=True, env=None):
        try:
            result = subprocess.run(args, input=input_text, text=True, capture_output=capture,
                                    env=dict(os.environ, **(env or {})))
        except FileNotFoundError:
            raise Stop(f"{args[0]} is not installed or not on PATH")
        if check and result.returncode != 0:
            detail = (result.stderr or result.stdout or "").strip() if capture else ""
            raise Stop(f"{' '.join(args[:4])} … failed (exit {result.returncode})", detail[-1500:])
        return result

    def kubectl(self, *args, ns=None, **kw):
        base = ["kubectl"] + (["--context", self.context] if self.context else []) + (["-n", ns] if ns else [])
        return self.run(base + list(args), **kw)

    def kjson(self, *args, ns=None):
        result = self.kubectl(*args, "-o", "json", ns=ns, check=False)
        return json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else None

    def helm(self, *args, ns=None, **kw):
        base = [self.cfg["HELM"]] + (["--kube-context", self.context] if self.context else []) + (["-n", ns] if ns else [])
        return self.run(base + list(args), **kw)


# ------------------------------------------------------------------ discovery


def check_tools(sh):
    say("tools")
    for tool in ("kubectl", sh.cfg["HELM"], sh.cfg["HELMFILE"], "git"):
        if not shutil.which(tool):
            raise Stop(f"{tool} not found", "Install it (openDesk needs the same tools), or set HELM / HELMFILE in synascriber.env.")
    version = sh.run([sh.cfg["HELM"], "version", "--short"]).stdout.strip()
    if not version.startswith("v3."):
        raise Stop(f"{sh.cfg['HELM']} is Helm {version}; openDesk and this installer need Helm 3",
                   "Install Helm 3 next to Helm 4 and set HELM=/path/to/helm3 in synascriber.env.")
    plugins = sh.run([sh.cfg["HELM"], "plugin", "list"]).stdout
    if not re.search(r"^diff\s", plugins, re.M):
        raise Stop("the helm-diff plugin is missing", f"{sh.cfg['HELM']} plugin install https://github.com/databus23/helm-diff")
    ok(f"kubectl, {version}, helm-diff, {sh.run([sh.cfg['HELMFILE'], '--version']).stdout.split()[-1]}, git")


def b64(data, key):
    return base64.b64decode(((data or {}).get("data") or {}).get(key, "")).decode() if data else ""


def dig(data, *keys, default=None):
    for key in keys:
        if not isinstance(data, dict) or key not in data:
            return default
        data = data[key]
    return data


def discover(sh):
    """Find openDesk and everything the add-on needs from it."""
    cfg = sh.cfg
    say("openDesk in your cluster")
    if not sh.context:
        sh.context = sh.kubectl("config", "current-context").stdout.strip()
    nodes = sh.kubectl("get", "nodes", "-o", "name", check=False)
    if nodes.returncode != 0:
        raise Stop(f"cluster not reachable with kube context {sh.context}", nodes.stderr.strip())
    ok(f"kube context {sh.context} ({len(nodes.stdout.split())} nodes)")

    releases = json.loads(sh.helm("list", "-A", "-a", "-o", "json").stdout or "[]")
    jitsis = [r for r in releases if r["chart"].startswith("opendesk-jitsi-")
              and (not cfg["OPENDESK_NAMESPACE"] or r["namespace"] == cfg["OPENDESK_NAMESPACE"])]
    if not jitsis:
        raise Stop("no openDesk Jitsi found (a Helm release with chart opendesk-jitsi)",
                   "Is openDesk installed with Jitsi? Set OPENDESK_NAMESPACE if Helm cannot list other namespaces.")
    if len(jitsis) > 1:
        raise Stop("more than one openDesk found: " + ", ".join(r["namespace"] for r in jitsis), "Set OPENDESK_NAMESPACE.")
    jitsi = jitsis[0]
    ns = jitsi["namespace"]
    if jitsi["status"] != "deployed":
        raise Stop(f"openDesk Jitsi in {ns} is {jitsi['status']}", "Fix openDesk first; this installer adds to a working openDesk.")
    values = json.loads(sh.helm("get", "values", jitsi["name"], "-o", "json", ns=ns).stdout or "{}")
    domain = dig(values, "global", "domain")
    if not domain:
        raise Stop(f"Jitsi release {jitsi['name']} has no global.domain", "Is it really openDesk's Jitsi?")
    hosts = dig(values, "global", "hosts", default={}) or {}
    t = {
        "context": sh.context,
        "namespace": ns,
        "domain": domain,
        "jitsiRelease": jitsi["name"],
        "jitsiChartVersion": jitsi["chart"].removeprefix("opendesk-jitsi-"),
        "jitsiValues": values,
        "jitsiHost": f"{hosts.get('jitsi', 'meet')}.{domain}",
        "keycloakHost": hosts.get("keycloak", "id"),
        "realm": dig(values, "settings", "keycloakRealm", default="opendesk"),
        "clusterDomain": dig(values, "jitsi", "global", "clusterDomain", default="cluster.local"),
        "releases": {r["name"]: r for r in releases if r["namespace"] == ns},
    }
    t["keycloakUrl"] = f"https://{t['keycloakHost']}.{domain}"
    t["issuer"] = f"{t['keycloakUrl']}/realms/{t['realm']}"
    t["synaplanHost"] = f"{cfg['SYNAPLAN_HOST']}.{domain}"
    t["synaplanUrl"] = f"https://{t['synaplanHost']}"
    ok(f"openDesk in namespace {ns}, domain {domain}, Jitsi chart {t['jitsiChartVersion']}")

    ingress = dig(values, "jitsi", "web", "ingress", default={}) or {}
    t["ingressClass"] = cfg["INGRESS_CLASS"] or ingress.get("ingressClassName") or "haproxy"
    tls_secret = ((ingress.get("tls") or [{}])[0] or {}).get("secretName") or "opendesk-certificates-tls"
    t["tls"] = tls_settings(sh, ns, domain, tls_secret)
    ok(f"ingress class {t['ingressClass']}; certificate: " + (
        f"reuse {t['tls']['secretName']}" if t["tls"]["secretName"]
        else f"cert-manager {t['tls']['issuerKind']} {t['tls']['issuerName']} issues synaplan-tls")
        + (f"; private CA from {t['tls']['caSecretName']}" if t["tls"]["caSecretName"] else ""))

    services = {s["metadata"]["name"]: s for s in (sh.kjson("get", "services", ns=ns) or {}).get("items", [])}
    t["prosodyService"] = f"{jitsi['name']}-prosody"
    if t["prosodyService"] not in services:
        raise Stop(f"Service {t['prosodyService']} not found in {ns}", "openDesk's Jitsi looks different than expected.")
    t["prosodyUrl"] = f"http://{t['prosodyService']}.{ns}.svc.{t['clusterDomain']}:5280"
    t["keycloakService"] = "ums-keycloak" if "ums-keycloak" in services else ""
    if not t["keycloakService"]:
        raise Stop(f"openDesk's Keycloak (Service ums-keycloak) not found in {ns}")

    collabora = cfg["COLLABORA_URL"]
    if collabora.lower() == "off":
        collabora = ""
    elif not collabora:
        for name, svc in services.items():
            ports = [p.get("port") for p in svc["spec"].get("ports", [])]
            if "collabora" in name and 9980 in ports:
                collabora = f"http://{name}.{ns}.svc.{t['clusterDomain']}:9980"
                break
    t["collaboraUrl"] = collabora
    ok(f"Collabora for Office previews: {collabora or 'not found, previews off'}")

    t["synaplanInstalled"] = "synaplan" in t["releases"]
    t["synaplanOurs"] = "synaplan-resources" in t["releases"]
    if t["synaplanInstalled"] and not t["synaplanOurs"]:
        raise Stop(f"a Synaplan is already installed in {ns}, but not by this add-on",
                   "This version installs its own Synaplan. Adding meeting notes to an existing Synaplan is not supported yet.")
    ok("Synaplan: " + ("installed by this add-on, will be updated" if t["synaplanInstalled"] else "not installed yet, will be added"))
    return t


def tls_settings(sh, ns, domain, secret_name):
    cfg = sh.cfg
    tls = {"secretName": "", "issuerKind": "ClusterIssuer", "issuerName": "letsencrypt-prod", "caSecretName": cfg["CA_SECRET"]}
    if cfg["TLS_SECRET"]:
        tls["secretName"] = cfg["TLS_SECRET"]
        return tls
    certs = (sh.kjson("get", "certificates.cert-manager.io", ns=ns) or {}).get("items", [])
    cert = next((c for c in certs if dig(c, "spec", "secretName") == secret_name), None)
    if cert:
        names = dig(cert, "spec", "dnsNames", default=[]) or []
        issuer = dig(cert, "spec", "issuerRef", default={}) or {}
        tls["issuerKind"] = issuer.get("kind", "Issuer")
        tls["issuerName"] = issuer.get("name", "")
        if f"*.{domain}" in names:
            tls["secretName"] = secret_name
        if not tls["caSecretName"]:
            kind = "clusterissuers.cert-manager.io" if tls["issuerKind"] == "ClusterIssuer" else "issuers.cert-manager.io"
            issuer_obj = sh.kjson("get", kind, tls["issuerName"], ns=None if tls["issuerKind"] == "ClusterIssuer" else ns)
            ca_secret = dig(issuer_obj or {}, "spec", "ca", "secretName")
            if ca_secret:
                tls["caSecretName"] = ca_secret
    if cfg["CERT_ISSUER"]:
        tls["issuerName"] = cfg["CERT_ISSUER"]
        tls["issuerKind"] = cfg["CERT_ISSUER_KIND"] or "ClusterIssuer"
    if not tls["secretName"] and not tls["issuerName"]:
        raise Stop("cannot tell how synaplan.<domain> gets a certificate",
                   "Set TLS_SECRET (a wildcard certificate Secret) or CERT_ISSUER (a cert-manager issuer) in synascriber.env.")
    return tls


def check_stt(sh, t):
    cfg = sh.cfg
    say("speech-to-text")
    if cfg["STT"] == "url":
        ok(f"your server {cfg['STT_URL']} (tested from inside the cluster during install)")
        return
    tag = stt_chart_app_version(sh)
    variant = "cuda" if cfg["STT"] == "gpu" else "cpu"
    image = f"{STT_IMAGE}:{tag}-{variant}"
    if not ghcr_tag_exists(STT_IMAGE.removeprefix("ghcr.io/"), f"{tag}-{variant}"):
        raise Stop(f"the speech-to-text image {image} is not published yet",
                   "Use STT=url with a Whisper server you run (README: 'Speech-to-text'), or wait for the release.")
    if cfg["STT"] == "gpu":
        nodes = (sh.kjson("get", "nodes") or {}).get("items", [])
        if not any(int(dig(n, "status", "allocatable", "nvidia.com/gpu", default="0") or 0) > 0 for n in nodes):
            raise Stop("STT=gpu, but no node offers nvidia.com/gpu", "Install the NVIDIA GPU operator, or use STT=cpu.")
    ok(f"{image} in the cluster ({'GPU' if cfg['STT'] == 'gpu' else 'CPU'})")


def stt_chart_app_version(sh):
    if sh.cfg["SYNAPLAN_CHARTS_PATH"]:
        chart = pathlib.Path(sh.cfg["SYNAPLAN_CHARTS_PATH"]) / "charts" / "stt" / "Chart.yaml"
        match = re.search(r'^appVersion:\s*"?([^"\s]+)', chart.read_text(), re.M) if chart.is_file() else None
        if match:
            return match.group(1)
    return "0.1.0"


def ghcr_tag_exists(repository, tag):
    try:
        with urllib.request.urlopen(f"https://ghcr.io/token?scope=repository:{repository}:pull", timeout=15) as r:
            token = json.load(r).get("token", "")
        request = urllib.request.Request(f"https://ghcr.io/v2/{repository}/manifests/{tag}", method="HEAD", headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json"})
        with urllib.request.urlopen(request, timeout=15):
            return True
    except (urllib.error.URLError, ValueError):
        return False


# ------------------------------------------------------------------ state


def state_dir(t):
    path = STATE_ROOT / re.sub(r"[^A-Za-z0-9_.-]", "_", t["context"]) / t["namespace"]
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    return path


def plugin_files():
    if not (PLUGIN_DIR / "manifest.json").is_file():
        raise Stop(f"{PLUGIN_DIR} has no manifest.json", "Run the installer from a complete synaScriber checkout.")
    return sorted(p.relative_to(PLUGIN_DIR).as_posix() for p in PLUGIN_DIR.rglob("*") if p.is_file())


def digest(base, names):
    h = hashlib.sha256()
    for name in names:
        h.update(name.encode())
        h.update((base / name).read_bytes())
    return h.hexdigest()[:16]


def stt_url(cfg, t):
    if cfg["STT"] == "url":
        return cfg["STT_URL"].rstrip("/")
    return f"http://synaplan-stt.{t['namespace']}.svc.{t['clusterDomain']}:8080"


def preview_ms(cfg):
    captions = cfg["LIVE_CAPTIONS"].lower()
    if captions == "off" or (captions == "auto" and cfg["STT"] == "cpu"):
        return 0
    return 1500


def write_state(sh, t, enabled=True):
    cfg = sh.cfg
    files = plugin_files()
    synaplan_values = {}
    if enabled:
        synaplan_values = {
            "volumes": [{"name": "synascriber-plugin", "configMap": {
                "name": "synascriber-plugin",
                "items": [{"key": f.replace("/", "__"), "path": f} for f in files]}}],
            "volumeMounts": [{"name": "synascriber-plugin", "mountPath": PLUGIN_MOUNT, "readOnly": True}],
            "podAnnotations": {"synascriber/plugin": digest(PLUGIN_DIR, files)},
        }
    state = {
        "opendesk": {
            "namespace": t["namespace"],
            "domain": t["domain"],
            "keycloakHost": t["keycloakHost"],
            "realm": t["realm"],
            "clusterDomain": t["clusterDomain"],
            "ingressClassName": t["ingressClass"],
            "tls": t["tls"],
            "collaboraUrl": t["collaboraUrl"],
        },
        "synaplan": {
            "host": cfg["SYNAPLAN_HOST"],
            "image": {"tag": cfg["SYNAPLAN_VERSION"]},
            "ai": {"ollamaUrl": cfg["OLLAMA_URL"]},
            "bootstrapAdminEmail": cfg["PLUGIN_OWNER_EMAIL"],
            "values": synaplan_values,
        },
        "stt": {"mode": "" if cfg["STT"] == "url" else cfg["STT"], "url": stt_url(cfg, t) if cfg["STT"] == "url" else ""},
        "synascriber": {
            "enabled": enabled,
            "transcriber": {"language": cfg["NOTES_DEFAULT_LANGUAGE"], "previewEveryMs": preview_ms(cfg)},
        },
    }
    if cfg["SYNAPLAN_CHARTS_PATH"]:
        state["synaplanCharts"] = {"path": str(pathlib.Path(cfg["SYNAPLAN_CHARTS_PATH"]).resolve())}
    path = state_dir(t) / "values.json"
    path.write_text(json.dumps(state, indent=1) + "\n", encoding="utf-8")
    path.chmod(0o600)
    return path


def helmfile(sh, state, *args, check=True):
    cmd = [sh.cfg["HELMFILE"], "--helm-binary", sh.cfg["HELM"], "--kube-context", sh.context,
           "-f", str(HERE / "helmfile.yaml.gotmpl"), "--state-values-file", str(state)] + list(args)
    print(f"   $ helmfile {' '.join(args)}", flush=True)
    result = subprocess.run(cmd, text=True)
    if check and result.returncode != 0:
        raise Stop(f"helmfile {args[0]} failed (exit {result.returncode})", "The output above names the release and the reason.")
    return result.returncode


# ------------------------------------------------------------------ Keycloak


def mapper(name, kind, **config):
    cfg = {"id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}
    cfg.update({key.replace("_", "."): value for key, value in config.items()})
    return {"name": name, "protocol": "openid-connect", "protocolMapper": kind, "consentRequired": False, "config": cfg}


def audience(name, client_id):
    m = mapper(name, "oidc-audience-mapper", included_client_audience=client_id)
    m["config"]["id.token.claim"] = "false"
    m["config"].pop("userinfo.token.claim")
    return m


# Nubus realms predate Keycloak's "basic" scope, so each client carries sub itself.
SUB = mapper("sub", "oidc-usermodel-property-mapper", user_attribute="id", claim_name="sub", jsonType_label="String")
EMAIL = mapper("email", "oidc-usermodel-property-mapper", user_attribute="email", claim_name="email", jsonType_label="String")
FULL_NAME = mapper("full name", "oidc-full-name-mapper")
USERNAME = mapper("username", "oidc-usermodel-property-mapper", user_attribute="username",
                  claim_name="preferred_username", jsonType_label="String")
GROUPS = mapper("groups", "oidc-group-membership-mapper", claim_name="groups", full_path="false")
DEFAULT_SCOPES = ["web-origins", "acr", "profile", "roles", "email"]


def clients(t):
    """The two Keycloak clients: Synaplan's sign-in and the Jitsi button's silent sign-in."""
    synaplan = t["synaplanUrl"]
    jitsi = f"https://{t['jitsiHost']}"
    return [
        {"clientId": "synaplan", "name": "Synaplan", "enabled": True, "protocol": "openid-connect",
         "publicClient": False, "clientAuthenticatorType": "client-secret",
         "standardFlowEnabled": True, "implicitFlowEnabled": False, "directAccessGrantsEnabled": False,
         "serviceAccountsEnabled": False, "frontchannelLogout": True, "fullScopeAllowed": True,
         "rootUrl": synaplan, "baseUrl": synaplan,
         "redirectUris": [f"{synaplan}/api/v1/auth/keycloak/callback"], "webOrigins": [synaplan],
         "attributes": {"post.logout.redirect.uris": f"{synaplan}/", "use.refresh.tokens": "true"},
         "defaultClientScopes": DEFAULT_SCOPES, "optionalClientScopes": ["offline_access"],
         "protocolMappers": [SUB, EMAIL, FULL_NAME, USERNAME, GROUPS, audience("synaplan-audience", "synaplan")],
         "_secret": ("synaplan-oidc-credentials", "client-secret")},
        {"clientId": "synascriber", "name": "Meeting notes (Jitsi button)", "enabled": True, "protocol": "openid-connect",
         "publicClient": True, "standardFlowEnabled": True, "implicitFlowEnabled": False,
         "directAccessGrantsEnabled": False, "serviceAccountsEnabled": False, "frontchannelLogout": True,
         "fullScopeAllowed": False, "rootUrl": jitsi, "baseUrl": jitsi,
         "redirectUris": [jitsi + SILENT_PATH], "webOrigins": [jitsi],
         "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+"},
         "defaultClientScopes": DEFAULT_SCOPES, "optionalClientScopes": [],
         "protocolMappers": [SUB, EMAIL, FULL_NAME, USERNAME, GROUPS, audience("synaplan-audience", "synaplan")]},
    ]


class PortForward:
    def __init__(self, sh, ns, target, port):
        self.args = ["kubectl"] + (["--context", sh.context] if sh.context else []) + [
            "-n", ns, "port-forward", target, f":{port}"]

    def __enter__(self):
        self.proc = subprocess.Popen(self.args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        line = self.proc.stdout.readline()
        match = re.search(r"127\.0\.0\.1:(\d+)", line)
        if not match:
            self.proc.kill()
            raise Stop("kubectl port-forward to Keycloak failed", (line + self.proc.stderr.read())[-500:])
        return int(match.group(1))

    def __exit__(self, *exc):
        self.proc.terminate()
        self.proc.wait(timeout=10)


def http(method, url, body=None, headers=None, form=None):
    hdrs = dict(headers or {})
    data = None
    if form is not None:
        data = urllib.parse.urlencode(form).encode()
        hdrs["Content-Type"] = "application/x-www-form-urlencoded"
    elif body is not None:
        data = json.dumps(body).encode()
        hdrs["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, method=method, headers=hdrs)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read()
            return response.status, json.loads(raw) if raw else None
    except urllib.error.HTTPError as error:
        raw = error.read().decode(errors="ignore")
        try:
            return error.code, json.loads(raw)
        except ValueError:
            return error.code, raw


class Keycloak:
    def __init__(self, base, realm, user, password, dry):
        self.dry = dry
        self.admin = f"{base}/admin/realms/{realm}"
        status, token = http("POST", f"{base}/realms/master/protocol/openid-connect/token",
                             form={"grant_type": "password", "client_id": "admin-cli", "username": user, "password": password})
        if status != 200:
            raise Stop(f"Keycloak admin sign-in failed (HTTP {status})", "The Keycloak admin password in openDesk's Secret did not work.")
        self.auth = {"Authorization": "Bearer " + token["access_token"]}

    def get(self, path):
        status, body = http("GET", self.admin + path, headers=self.auth)
        if status != 200:
            raise Stop(f"Keycloak GET {path} failed (HTTP {status})", str(body)[:300])
        return body

    def send(self, method, path, body, what):
        print(f"   {'(dry) ' if self.dry else ''}{what}", flush=True)
        if self.dry:
            return
        status, answer = http(method, self.admin + path, body=body, headers=self.auth)
        if status not in (200, 201, 204):
            raise Stop(f"Keycloak: {what} failed (HTTP {status})", str(answer)[:300])

    def client(self, client_id):
        found = self.get(f"/clients?clientId={urllib.parse.quote(client_id)}")
        return found[0] if found else None


def keycloak_admin(sh, ns):
    pw = b64(sh.kjson("get", "secret", "keycloak-admin-password", ns=ns), "adminPassword")
    if pw:
        return "kcadmin", pw
    raw = b64(sh.kjson("get", "secret", "opendesk-keycloak-bootstrap-admin-creds", ns=ns), "admin.yaml")
    user = re.search(r"^username:\s*['\"]?([^'\"\n]+)", raw, re.M)
    pw = re.search(r"^password:\s*['\"]?([^'\"\n]+)", raw, re.M)
    if user and pw:
        return user.group(1), pw.group(1)
    if os.environ.get("KEYCLOAK_ADMIN_PASSWORD"):
        return os.environ.get("KEYCLOAK_ADMIN_USER", "kcadmin"), os.environ["KEYCLOAK_ADMIN_PASSWORD"]
    raise Stop("openDesk's Keycloak admin password not found (Secret keycloak-admin-password)",
               "Set KEYCLOAK_ADMIN_USER and KEYCLOAK_ADMIN_PASSWORD in your shell.")


def same(want, have):
    if isinstance(want, dict):
        return isinstance(have, dict) and all(same(v, have.get(k)) for k, v in want.items())
    if isinstance(want, list):
        return isinstance(have, list) and sorted(map(str, want)) == sorted(map(str, have))
    return str(want).lower() == str(have).lower() if isinstance(want, bool) else want == have


def ensure_client(kc, rep, secret):
    rep = dict(rep)
    mappers = rep.pop("protocolMappers")
    default_scopes = rep.pop("defaultClientScopes")
    optional_scopes = rep.pop("optionalClientScopes")
    rep.pop("_secret", None)
    if secret:
        rep["secret"] = secret
    cid = rep["clientId"]
    have = kc.client(cid)
    if have is None:
        kc.send("POST", "/clients", dict(rep, protocolMappers=mappers, defaultClientScopes=default_scopes,
                                         optionalClientScopes=optional_scopes), f"+ client {cid} created")
        return
    check = {k: v for k, v in rep.items() if k != "secret"}
    current_secret = (kc.get(f"/clients/{have['id']}/client-secret") or {}).get("value") if secret else None
    changed = sorted(k for k, v in check.items() if not same(v, have.get(k)))
    if secret and secret != current_secret:
        changed.append("secret")
    if changed:
        merged = dict(have, **{k: v for k, v in rep.items() if k != "attributes"})
        merged["attributes"] = dict(have.get("attributes") or {}, **rep.get("attributes", {}))
        merged.pop("protocolMappers", None)
        kc.send("PUT", f"/clients/{have['id']}", merged, f"~ client {cid} updated: {', '.join(changed)}")
    else:
        ok(f"client {cid} unchanged")
    existing = {m["name"]: m for m in kc.get(f"/clients/{have['id']}/protocol-mappers/models") or []}
    for m in mappers:
        got = existing.get(m["name"])
        if got is None:
            kc.send("POST", f"/clients/{have['id']}/protocol-mappers/models", m, f"+ client {cid}: mapper {m['name']}")
        elif got["protocolMapper"] != m["protocolMapper"] or not same(m["config"], got.get("config", {})):
            kc.send("PUT", f"/clients/{have['id']}/protocol-mappers/models/{got['id']}", dict(m, id=got["id"]),
                    f"~ client {cid}: mapper {m['name']}")
    scopes = {s["name"]: s["id"] for s in kc.get("/client-scopes")}
    for kind, wanted in (("default", default_scopes), ("optional", optional_scopes)):
        attached = {s["name"] for s in kc.get(f"/clients/{have['id']}/{kind}-client-scopes") or []}
        for name in wanted:
            if name in attached or name not in scopes:
                continue
            kc.send("PUT", f"/clients/{have['id']}/{kind}-client-scopes/{scopes[name]}", None, f"+ client {cid}: {kind} scope {name}")


def step_keycloak(sh, t, dry=False, remove=()):
    say("Keycloak: sign-in for Synaplan and the Jitsi button")
    ns = t["namespace"]
    user, password = keycloak_admin(sh, ns)
    with PortForward(sh, ns, f"svc/{t['keycloakService']}", 8080) as port:
        kc = Keycloak(f"http://127.0.0.1:{port}", t["realm"], user, password, dry)
        if remove:
            for cid in remove:
                have = kc.client(cid)
                if have:
                    kc.send("DELETE", f"/clients/{have['id']}", None, f"- client {cid} removed")
            return
        for rep in clients(t):
            secret = None
            if rep.get("_secret"):
                name, key = rep["_secret"]
                secret = b64(sh.kjson("get", "secret", name, ns=ns), key)
                if not secret and not dry:
                    raise Stop(f"Secret {name} not found in {ns}", "Run the Synaplan part first (./synascriber install).")
            ensure_client(kc, rep, secret)


