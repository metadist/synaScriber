def web_pod(sh, ns):
    pods = (sh.kjson("get", "pods", "-l", WEB_POD_SELECTOR, ns=ns) or {}).get("items", [])
    ready = [p["metadata"]["name"] for p in pods
             if all(c.get("ready") for c in dig(p, "status", "containerStatuses", default=[]) or [{}])]
    if not ready:
        raise Stop(f"no ready Synaplan web pod in {ns}", f"kubectl -n {ns} get pods -l app.kubernetes.io/name=synaplan")
    return ready[0]


def in_synaplan(sh, ns, pod, *args, input_text=None, check=True):
    return sh.kubectl("exec", "-i", pod, "-c", "synaplan", "--", *args,
                      ns=ns, input_text=input_text if input_text is not None else "", check=check)


def secret_value(sh, ns, name, key):
    value = b64(sh.kjson("get", "secret", name, ns=ns), key)
    if not value:
        raise Stop(f"Secret {name} (key {key}) not found in {ns}", "Run ./synascriber install.")
    return value


def step_plugin(sh, t):
    cfg = sh.cfg
    ns = t["namespace"]
    say("Synaplan: meeting-notes plugin")
    pod = web_pod(sh, ns)
    email = cfg["PLUGIN_OWNER_EMAIL"] or b64(sh.kjson("get", "secret", "synaplan-bootstrap-admin", ns=ns), "email")
    owner = json.loads(in_synaplan(sh, ns, pod, "php", "-r", PHP_OWNER, email, input_text="").stdout.strip() or "{}").get("owner")
    if not owner:
        raise Stop(f"no Synaplan administrator found (looked for {email})",
                   f"kubectl -n {ns} logs {pod} -c synaplan | grep -i 'administrator'")
    ok(f"plugin owner: Synaplan user {owner} ({email})")
    t["ownerId"] = owner
    for command in (["app:plugin:install", str(owner), "synascriber"], ["app:plugin:install-verified-users", "synascriber"]):
        result = in_synaplan(sh, ns, pod, "php", "/var/www/backend/bin/console", *command, "--no-interaction",
                             input_text="", check=False)
        text = (result.stdout + result.stderr).strip().splitlines()
        if result.returncode != 0:
            raise Stop(f"{command[0]} failed", "\n".join(text[-8:]))
        last = next((l.strip() for l in reversed(text) if l.strip() and not l.lstrip().startswith("{")), "done")
        ok(f"{command[0]}: {re.sub(r'^\[OK\]\s*', '', last)}")
    api_key = secret_value(sh, ns, "synascriber", "api-key")
    result = in_synaplan(sh, ns, pod, "php", "-r", PHP_API_KEY, str(owner), input_text=api_key + "\n")
    ok(f"transcriber API key: {result.stdout.strip()}")
    settings = {
        "enabled": True,
        "languages": [x.strip() for x in cfg["NOTES_LANGUAGES"].split(",") if x.strip()],
        "default_language": cfg["NOTES_DEFAULT_LANGUAGE"],
        "default_folder": cfg["NOTES_FOLDER"],
        "stt_url": stt_url(cfg, t),
        "stt_model": cfg["STT_MODEL"] or "whisper",
        "stt_api_key": cfg["STT_API_KEY"] if cfg["STT"] == "url" else "",
        "prosody_url": t["prosodyUrl"],
        "prosody_secret": secret_value(sh, ns, "synascriber", "prosody-secret"),
        "owner_user_id": owner,
