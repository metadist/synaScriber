def jitsi_chart(sh, t):
    """The deployed opendesk-jitsi chart, pulled once; tells which Jicofo hook it has."""
    version = t["jitsiChartVersion"]
    cache = STATE_ROOT / "charts" / f"opendesk-jitsi-{version}"
    if not (cache / "opendesk-jitsi" / "Chart.yaml").is_file():
        cache.mkdir(parents=True, exist_ok=True)
        sh.run([sh.cfg["HELM"], "pull", sh.cfg["JITSI_CHART"], "--version", version, "--untar", "--untardir", str(cache)])
    chart = cache / "opendesk-jitsi"
    modern = (chart / "charts" / "jitsi-meet" / "templates" / "jicofo" / "configmap-configs.yaml").is_file()
    return chart, modern


def jitsi_entries(sh, t, modern):
    """What meeting notes add to openDesk's Jitsi. No secrets: Prosody and Jicofo read them from Secrets."""
    ns, cd = t["namespace"], t["clusterDomain"]
    loader = f"{t['synaplanUrl']}/api/v1/user/{t['ownerId']}/plugins/synascriber/assets/jitsi/loader.js"
    head = (f'<script defer src="{loader}" data-synaplan="{t["synaplanUrl"]}" data-issuer="{t["issuer"]}" '
            f'data-client-id="synascriber"></script>\n')
    jicofo_conf = (
        "jicofo {\n"
        "  transcription {\n"
        f"    url-template = \"ws://synascriber-transcriber.{ns}.svc.{cd}:8095/transcribe?sessionId={{{{MEETING_ID}}}}\"\n"
        "    http-headers {\n"
        "      \"Authorization\" = \"Bearer \"${?SYNASCRIBER_TRANSCRIBER_TOKEN}\n"
        "    }\n"
        "  }\n"
        "}\n")
    secrets = hashlib.sha256((secret_value(sh, ns, "synascriber", "prosody-secret") + "\n" +
                              secret_value(sh, ns, "synascriber", "transcriber-token")).encode()).hexdigest()[:12]
    # Every reference is optional: Jitsi keeps starting after an uninstall even
    # if these settings are still in the openDesk environment.
    jicofo = {"extraEnvFrom": [{"secretRef": {"name": "synascriber-jicofo", "optional": True}}],
              "podAnnotations": {"synascriber/secrets": secrets}}
    entries = {}
    if modern:
        jicofo["custom"] = {"configs": {"_custom_jicofo_conf": jicofo_conf}}
    else:
        # Older charts have no jicofo.extraEnvFrom; this hook reaches every Jitsi container.
        jicofo.pop("extraEnvFrom")
        entries["global"] = {"releaseSecretsOverride": {"enabled": True, "extraEnvFrom": [
            {"secretRef": {"name": "synascriber-jicofo", "optional": True}}]}}
        jicofo["extraFiles"] = [
            {"path": JICOFO_DEFAULTS, "content": jicofo_conf},
            {"path": JICOFO_INIT, "mode": "0755", "content": (
                "#!/usr/bin/with-contenv bash\n"
                f"cp {JICOFO_DEFAULTS} /config/custom-jicofo.conf\n"
                "chown jicofo:jitsi /config/custom-jicofo.conf\n")},
        ]
    return {"jitsi": dict(entries, **{
        "web": {"extraFiles": [
            {"path": HEAD_FILE, "content": head},
            {"path": SILENT_FILE, "content": SILENT_PAGE.read_text(encoding="utf-8")},
        ]},
        "prosody": {
            "extraEnvs": {"XMPP_MODULES": "synascriber"},
            "extraEnvFrom": [{"secretRef": {"name": "synascriber-prosody", "optional": True}}],
            "extraVolumes": [{"name": "synascriber-prosody", "configMap": {"name": "synascriber-prosody", "optional": True}}],
            "extraVolumeMounts": [{"name": "synascriber-prosody", "mountPath": MODULE_MOUNT,
                                   "subPath": "mod_synascriber.lua", "readOnly": True}],
            "podAnnotations": {"synascriber/module": digest(PROSODY_MODULE.parent, [PROSODY_MODULE.name]), "synascriber/secrets": secrets},
        },
        "jicofo": jicofo,
    })}


def item_key(item):
    if isinstance(item, dict):
        for key in ("path", "name", "mountPath"):
            if key in item:
                return (key, item[key])
        if "secretRef" in item:
            return ("secretRef", item["secretRef"].get("name"))
        if "configMapRef" in item:
            return ("configMapRef", item["configMapRef"].get("name"))
    return ("value", json.dumps(item, sort_keys=True))


def merge(base, add):
    """Deep merge; lists of named items are merged by name/path instead of replaced."""
    if isinstance(base, dict) and isinstance(add, dict):
        out = dict(base)
        for key, value in add.items():
            if key == "XMPP_MODULES" and base.get(key):
                mods = [m for m in base[key].split(",") if m.strip()]
                out[key] = ",".join(mods + [m for m in value.split(",") if m not in mods])
            else:
                out[key] = merge(base.get(key), value) if key in base else value
        return out
    if isinstance(base, list) and isinstance(add, list):
        out = [item for item in base if item_key(item) not in {item_key(a) for a in add}]
        return out + add
    return add


def unmerge(base, ours):
    """base without what merge() added from ours."""
    if isinstance(base, dict) and isinstance(ours, dict):
        out = dict(base)
        for key, value in ours.items():
            if key not in base:
                continue
            if key == "XMPP_MODULES":
                mods = [m for m in base[key].split(",") if m.strip() and m not in value.split(",")]
                if mods:
                    out[key] = ",".join(mods)
                else:
                    out.pop(key)
            elif isinstance(value, (dict, list)):
                out[key] = unmerge(base[key], value)
                if out[key] in ({}, []):
                    out.pop(key)
            elif key != "enabled":
                out.pop(key)
        # A switch stays when it still guards someone else's settings next to it.
        if "enabled" in ours and "enabled" in out and len(out) == 1:
            out.pop("enabled")
        return out
    if isinstance(base, list) and isinstance(ours, list):
        keys = {item_key(o) for o in ours}
        return [item for item in base if item_key(item) not in keys]
    return base


def step_jitsi(sh, t, assume_yes, dry=False, remove=False):
    ns = t["namespace"]
    say("Jitsi: button and sign-in page, Prosody module, bridge to the transcriber")
    chart, modern = jitsi_chart(sh, t)
    note(f"opendesk-jitsi {t['jitsiChartVersion']}: Jicofo settings via "
         + ("custom-jicofo.conf of the chart" if modern else "a start script (older chart)"))
    ours = jitsi_entries(sh, t, modern)
    current = t["jitsiValues"]
    if remove:
        wanted = unmerge(current, strip_volatile(ours))
    else:
        wanted = merge(unmerge(current, strip_volatile(ours)), ours)
    if wanted == current:
        ok("Jitsi already has the current meeting-notes settings")
        return False
    out = state_dir(t) / "jitsi-values.json"
    out.write_text(json.dumps(wanted, indent=1) + "\n", encoding="utf-8")
    out.chmod(0o600)
    args = ["upgrade", t["jitsiRelease"], str(chart), "--reset-values", "-f", str(out)]
    if dry:
        diff = sh.helm("diff", *args, "--context", "3", ns=ns, check=False)
        print(re.sub(r"^", "   ", (diff.stdout or diff.stderr).strip() or "(no difference)", flags=re.M))
        return True
    if not ask("Jitsi's Prosody, Jicofo and web restart now; running meetings end. Continue?", assume_yes):
        raise Stop("stopped before changing Jitsi", "Run again when no meeting is running, or with --yes.")
    sh.helm(*args, "--timeout", "10m", ns=ns)
    for kind, name in (("statefulset", f"{t['jitsiRelease']}-prosody"), ("deployment", f"{t['jitsiRelease']}-jicofo"),
                       ("deployment", f"{t['jitsiRelease']}-web")):
        sh.kubectl("rollout", "status", f"{kind}/{name}", "--timeout=600s", ns=ns)
    ok("Jitsi rolled out" + (" without meeting notes" if remove else ""))
    return True


def strip_volatile(entries):
    """Our entries with every value that can change between runs, so older versions are found and replaced."""
    def walk(node):
        if isinstance(node, dict):
            return {k: ("" if k in ("content", "_custom_jicofo_conf", "synascriber/module", "synascriber/secrets") else walk(v))
                    for k, v in node.items()}
        if isinstance(node, list):
            return [walk(v) for v in node]
        return node
    return walk(entries)


