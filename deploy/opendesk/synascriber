class Udm:
    """openDesk's directory (Nubus UDM REST API), as its Administrator."""

    def __init__(self, sh, ns, port):
        password = b64(sh.kjson("get", "secret", "ums-nubus-credentials", ns=ns), "administrator_password") \
            or os.environ.get("OPENDESK_ADMINISTRATOR_PASSWORD", "")
        if not password:
            raise Stop("openDesk's Administrator password not found (Secret ums-nubus-credentials)",
                       "Set OPENDESK_ADMINISTRATOR_PASSWORD in your shell.")
        self.base = f"http://127.0.0.1:{port}/univention/udm"
        self.auth = {"Authorization": "Basic " + base64.b64encode(f"Administrator:{password}".encode()).decode(),
                     "Accept": "application/json"}

    def get(self, path):
        status, body = http("GET", f"{self.base}/{path}", headers=self.auth)
        if status == 401:
            raise Stop("openDesk's directory refused the Administrator password from Secret ums-nubus-credentials",
                       "If you changed it, set OPENDESK_ADMINISTRATOR_PASSWORD in your shell.")
        return body if status == 200 else None

    def objects(self, kind, query):
        body = self.get(f"{kind}/?{query}&properties=*") or {}
        return body.get("_embedded", {}).get("udm:object", [])

    def write(self, method, url, body):
        headers = dict(self.auth)
        if method in ("PATCH", "DELETE"):
            request = urllib.request.Request(url, method="GET", headers=self.auth)
            with urllib.request.urlopen(request, timeout=30) as response:
                headers["If-Match"] = response.headers.get("ETag", "*")
        status, answer = http(method, url, body=body, headers=headers)
        if status not in (200, 201, 204):
            raise Stop(f"openDesk's directory: {method} failed (HTTP {status})", str(answer)[:300])


def step_portal(sh, t, remove=False):
    """The Synaplan tile in openDesk's portal and its app menu (category Applications)."""
    ns = t["namespace"]
    say("portal: Synaplan tile" + (" removed" if remove else ""))
    with PortForward(sh, ns, "svc/ums-udm-rest-api", 9979) as port:
        udm = Udm(sh, ns, port)
        categories = udm.objects("portals/category", f"filter=cn%3D{PORTAL_CATEGORY}")
        if not categories:
            warn(f"openDesk's portal has no category {PORTAL_CATEGORY}; no tile")
            return
        category = categories[0]
        container = category["dn"].split(",", 2)[2]
        entries = udm.objects("portals/entry", f"filter=cn%3D{PORTAL_ENTRY}")
        entry_dn = entries[0]["dn"] if entries else f"cn={PORTAL_ENTRY},cn=entry,{container}"
        listed = category["properties"].get("entries") or []
        category_url = f"{udm.base}/portals/category/{urllib.parse.quote(category['dn'], safe='')}"
        if remove:
            if entry_dn in listed:
                udm.write("PATCH", category_url, {"properties": {"entries": [e for e in listed if e != entry_dn]}})
            if entries:
                udm.write("DELETE", f"{udm.base}/portals/entry/{urllib.parse.quote(entry_dn, safe='')}", None)
            ok("tile removed")
            return
        properties = {
            "name": PORTAL_ENTRY,
            "displayName": {"en_US": "Synaplan", "de_DE": "Synaplan"},
            "description": {"en_US": "AI assistant for your documents and meeting notes",
                            "de_DE": "KI-Assistent für Ihre Dokumente und Mitschriften"},
            "link": [["en_US", t["synaplanUrl"]]],
            "linkTarget": "newwindow",
            "target": "tab_synaplan",
            "activated": True,
            "anonymous": False,
            "allowedGroups": [],
        }
        icon = in_synaplan(sh, ns, web_pod(sh, ns), "curl", "-sf", "-m", "10", "http://127.0.0.1/single_bird.svg", check=False)
        if icon.returncode == 0 and "<svg" in icon.stdout:
            properties["icon"] = base64.b64encode(icon.stdout.encode()).decode()
        if entries:
            current = entries[0]["properties"]
            if any(current.get(k) != v for k, v in properties.items() if k != "icon") or \
                    ("icon" in properties and current.get("icon") != properties["icon"]):
                udm.write("PATCH", f"{udm.base}/portals/entry/{urllib.parse.quote(entry_dn, safe='')}", {"properties": properties})
                ok("tile updated")
            else:
                ok("tile unchanged")
        else:
            udm.write("POST", f"{udm.base}/portals/entry/", {"position": f"cn=entry,{container}", "properties": properties})
            ok("tile created")
        if entry_dn not in listed:
            udm.write("PATCH", category_url, {"properties": {"entries": listed + [entry_dn]}})
            ok(f"tile added to the portal's {category['properties'].get('displayName', {}).get('en_US', PORTAL_CATEGORY)}")


def portal_listed(sh, t):
    with PortForward(sh, t["namespace"], "svc/ums-udm-rest-api", 9979) as port:
        udm = Udm(sh, t["namespace"], port)
        categories = udm.objects("portals/category", f"filter=cn%3D{PORTAL_CATEGORY}")
        return any(e.startswith(f"cn={PORTAL_ENTRY},") for c in categories for e in c["properties"].get("entries") or [])


# ------------------------------------------------------------------ openDesk environment files


def yaml(node, indent=0):
    pad = "  " * indent
    if isinstance(node, dict):
        if not node:
            return "{}"
        lines = []
        for key, value in node.items():
            k = key if re.fullmatch(r"[A-Za-z0-9_.-]+", key) else json.dumps(key)
            if isinstance(value, (dict, list)) and value:
                lines.append(f"{pad}{k}:\n{yaml(value, indent + 1)}")
            else:
                lines.append(f"{pad}{k}: {yaml(value)}")
        return "\n".join(lines)
    if isinstance(node, list):
        if not node:
            return "[]"
        lines = []
        for value in node:
            if isinstance(value, dict) and value:
                inner = yaml(value, indent + 1).lstrip()
                lines.append(f"{pad}- {inner}")
            else:
                lines.append(f"{pad}- {yaml(value)}")
        return "\n".join(lines)
    if isinstance(node, bool):
        return "true" if node else "false"
    if isinstance(node, (int, float)):
        return str(node)
    return json.dumps(node if node is not None else "", ensure_ascii=False)


def step_opendesk_env(sh, t, quiet=False):
    """Files for the openDesk environment, so openDesk updates keep meeting notes."""
    folder = state_dir(t) / "opendesk"
    folder.mkdir(exist_ok=True)
    _, modern = jitsi_chart(sh, t)
    jitsi_file = folder / "synascriber-jitsi.yaml"
    jitsi_file.write_text("# Meeting notes in openDesk's Jitsi (synaScriber). Generated by ./synascriber; no secrets.\n"
                          + yaml(jitsi_entries(sh, t, modern)) + "\n", encoding="utf-8")
    oidc = {}
    for rep in clients(t):
        rep = dict(rep)
        secret = rep.pop("_secret", None)
        if secret:
            rep["secret"] = {"existingSecret": {"name": secret[0], "key": secret[1]}}
        oidc[rep["clientId"]] = rep
    env_file = folder / "synascriber.yaml.gotmpl"
    env_file.write_text(
        "# Meeting notes (synaScriber) for this openDesk. Generated by ./synascriber; no secrets.\n"
        "# Copy into your openDesk environment folder, e.g. helmfile/environments/<env>/,\n"
        "# and keep synascriber-jitsi.yaml where the path below points.\n"
        + yaml({"functional": {"authentication": {"oidc": {"clients": oidc}}},
                "customization": {"release": {"jitsi": {"synascriber": str(jitsi_file)}}}}) + "\n",
        encoding="utf-8")
    if not quiet:
        say("openDesk environment")
        ok(f"{env_file}")
        ok(f"{jitsi_file}")
        print(textwrap_block(f"""
          openDesk's own deployment removes Keycloak clients and Jitsi settings it does
          not know. Copy {env_file.name} into your openDesk environment folder
          (e.g. helmfile/environments/dev/), then once:

            helmfile apply -e <env> -n {t['namespace']} -l name=opendesk-keycloak-bootstrap
            helmfile apply -e <env> -n {t['namespace']} -l name={t['jitsiRelease']}

          From then on every openDesk update keeps meeting notes."""))
    return env_file


def textwrap_block(text):
    lines = text.strip("\n").splitlines()
    margin = min(len(l) - len(l.lstrip()) for l in lines if l.strip())
    return "\n".join("   " + l[margin:] if l.strip() else "" for l in lines)


def persistent(sh, t):
    values = json.loads(sh.helm("get", "values", "opendesk-keycloak-bootstrap", "-o", "json",
                                ns=t["namespace"], check=False).stdout or "{}")
    custom = dig(values, "config", "custom", "clients", default={}) or {}
    return all(cid in custom for cid in ("synaplan", "synascriber"))


# ------------------------------------------------------------------ verify


TLS_CONTEXT = None


def trust_private_ca(sh, t):
    """For openDesk with self-signed certificates: verify against its CA."""
    global TLS_CONTEXT
    if t["tls"]["caSecretName"]:
        ca = b64(sh.kjson("get", "secret", t["tls"]["caSecretName"], ns=t["namespace"]), "ca.crt")
        if ca:
            TLS_CONTEXT = ssl.create_default_context(cadata=ca)


def fetch(url):
    try:
        request = urllib.request.Request(url, headers={"User-Agent": "synascriber-verify"})
        with urllib.request.urlopen(request, timeout=20, context=TLS_CONTEXT) as r:
            return r.status, r.read().decode(errors="ignore")
    except urllib.error.HTTPError as error:
        return error.code, ""
    except (urllib.error.URLError, OSError) as error:
        return 0, str(error)


def step_verify(sh, t):
    ns = t["namespace"]
    say("verify")
    trust_private_ca(sh, t)
    problems = 0

    def check(good, text, fix=""):
        nonlocal problems
        if good:
            ok(text)
        else:
            problems += 1
            warn(text + (f" — {fix}" if fix else ""))

    for kind, name in (("statefulset", "synaplan-mariadb"), ("deployment", "synaplan"), ("deployment", "synaplan-worker"),
                       ("deployment", "synaplan-scheduler"), ("deployment", "synascriber-transcriber")):
        obj = sh.kjson("get", kind, name, ns=ns) or {}
        want, ready = dig(obj, "spec", "replicas", default=1), dig(obj, "status", "readyReplicas", default=0)
        check(obj and ready == want, f"{name}: {ready or 0}/{want} ready", f"kubectl -n {ns} describe {kind} {name}")
    status, body = fetch(f"{t['synaplanUrl']}/api/health")
    check(status == 200, f"Synaplan answers at {t['synaplanUrl']} (HTTP {status})",
          "DNS for the Synaplan name, or the certificate (kubectl -n %s get certificate)" % ns)
    pod = web_pod(sh, ns)
    email = sh.cfg["PLUGIN_OWNER_EMAIL"] or b64(sh.kjson("get", "secret", "synaplan-bootstrap-admin", ns=ns), "email")
    owner = json.loads(in_synaplan(sh, ns, pod, "php", "-r", PHP_OWNER, email, input_text="").stdout.strip() or "{}").get("owner")
    t["ownerId"] = owner
    loader = f"{t['synaplanUrl']}/api/v1/user/{owner}/plugins/synascriber/assets/jitsi/loader.js"
    status, _ = fetch(loader)
    check(status == 200, f"the Jitsi button script is served (HTTP {status})", "./synascriber install (plugin step)")
    status, page = fetch(f"https://{t['jitsiHost']}/")
    check("synascriber/assets/jitsi/loader.js" in page, "Jitsi pages load the button script", "./synascriber install (Jitsi step)")
    status, _ = fetch(f"https://{t['jitsiHost']}{SILENT_PATH}")
    check(status == 200, f"the silent sign-in page is served (HTTP {status})", "./synascriber install (Jitsi step)")
    try:
        check(portal_listed(sh, t), "Synaplan tile in openDesk's portal", "./synascriber install (portal step)")
    except Stop as stop:
        check(False, f"portal tile: {stop}")
    module = sh.kubectl("exec", "deploy/synascriber-transcriber", "--", "wget", "-qO-", f"{t['prosodyUrl']}/synascriber/health",
                        ns=ns, check=False)
    check('"ok":true' in module.stdout.replace(" ", ""), "Prosody module answers: " + (module.stdout.strip() or module.stderr.strip())[:120])
    health = sh.kubectl("exec", "deploy/synascriber-transcriber", "--", "wget", "-qO-", "http://127.0.0.1:8095/health",
                        ns=ns, check=False)
    check(health.returncode == 0, "transcriber answers: " + (health.stdout.strip() or health.stderr.strip())[:120])
    try:
        checks = plugin_api(sh, t, pod, "GET", "/admin/status")
        report_checks(checks)
        problems += sum(1 for good in checks.values() if not good)
    except Stop as stop:
        check(False, str(stop), stop.hint[:200])
    if persistent(sh, t):
        ok("openDesk's environment declares the meeting-notes clients (kept through openDesk updates)")
    else:
        warn("openDesk's environment does not declare the meeting-notes clients yet: the next openDesk "
             "deployment removes them. ./synascriber opendesk-env shows what to add.")
    return problems


# ------------------------------------------------------------------ main flows


def summary(sh, t):
    ns = t["namespace"]
    say("done")
    print(textwrap_block(f"""
      Synaplan:       {t['synaplanUrl']}  (sign in with your openDesk account)
      Meetings:       https://{t['jitsiHost']}  → the "Meeting notes" button appears after you join
      Transcripts:    Synaplan › Sources › Generated, folder {sh.cfg['NOTES_FOLDER']}

      Synaplan's local administrator (owns the plugin; people use Keycloak):
        email:    {b64(sh.kjson('get', 'secret', 'synaplan-bootstrap-admin', ns=ns), 'email')}
        password: kubectl -n {ns} get secret synaplan-bootstrap-admin -o jsonpath='{{.data.password}}' | base64 -d
    """))


def wait_rollouts(sh, t):
    ns = t["namespace"]
    say("waiting for Synaplan (the first start creates the database, a few minutes)")
    targets = [("statefulset", "synaplan-mariadb"), ("deployment", "synascriber-transcriber"),
               ("deployment", "synaplan"), ("deployment", "synaplan-worker"), ("deployment", "synaplan-scheduler")]
    if sh.cfg["STT"] != "url":
        targets.insert(1, ("deployment", "synaplan-stt"))
    for kind, name in targets:
        result = sh.kubectl("rollout", "status", f"{kind}/{name}", "--timeout=900s", ns=ns, check=False)
        if result.returncode != 0:
            raise Stop(f"{name} did not become ready", f"kubectl -n {ns} describe {kind} {name}; kubectl -n {ns} logs {kind}/{name}")
        ok(f"{name} ready")


def stt_reachable(sh, t):
    url = stt_url(sh.cfg, t)
    pod = web_pod(sh, t["namespace"])
    result = in_synaplan(sh, t["namespace"], pod, "curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-m", "10",
                         url + "/health", input_text="", check=False)
    (ok if result.stdout.strip() == "200" else warn)(f"speech-to-text {url}/health from Synaplan: HTTP {result.stdout.strip() or '-'}")


def cmd_check(sh, args):
    check_tools(sh)
    t = discover(sh)
    check_stt(sh, t)
    say("what install would do")
    print(textwrap_block(f"""
      1. Synaplan {sh.cfg['SYNAPLAN_VERSION']} at {t['synaplanUrl']}, with its own MariaDB, in namespace {t['namespace']}
      2. speech-to-text: {'your server ' + sh.cfg['STT_URL'] if sh.cfg['STT'] == 'url' else 'synaplan-stt (' + sh.cfg['STT'] + ')'}
      3. the meeting-notes plugin, the transcriber and the Prosody module (release synascriber)
      4. two Keycloak clients in realm {t['realm']}: synaplan, synascriber, and a Synaplan tile in openDesk's portal
      5. openDesk's Jitsi ({t['jitsiRelease']}): button, sign-in page, Prosody module, bridge to the transcriber
         (Prosody, Jicofo and Jitsi web restart once; running meetings end)
    """))
    return t


def cmd_plan(sh, args):
    t = cmd_check(sh, args)
    say("Helm releases (diff)")
    helmfile(sh, write_state(sh, t), "diff", "--suppress-secrets", "--context", "3", "--diff-args", "--dry-run=server", check=False)
    if "synaplan-resources" in t["releases"] and sh.kjson("get", "secret", "synascriber", ns=t["namespace"]):
        step_keycloak(sh, t, dry=True)
        try:
            step_plugin_owner_only(sh, t)
            step_jitsi(sh, t, True, dry=True)
        except Stop as stop:
            warn(f"Jitsi preview skipped: {stop}")
    else:
        note("Keycloak and Jitsi previews follow after the first install (they need Synaplan's secrets).")


def step_plugin_owner_only(sh, t):
    ns = t["namespace"]
    pod = web_pod(sh, ns)
    email = sh.cfg["PLUGIN_OWNER_EMAIL"] or b64(sh.kjson("get", "secret", "synaplan-bootstrap-admin", ns=ns), "email")
    t["ownerId"] = json.loads(in_synaplan(sh, ns, pod, "php", "-r", PHP_OWNER, email, input_text="").stdout.strip() or "{}").get("owner")


def cmd_install(sh, args):
    t = cmd_check(sh, args)
    if not ask("Install now?", args.yes):
        raise Stop("nothing changed")
    say("Helm releases: Synaplan and meeting notes")
    module_before = (sh.kjson("get", "configmap", "synascriber-prosody", ns=t["namespace"]) or {}).get("data")
    helmfile(sh, write_state(sh, t), "apply", "--suppress-diff", "--diff-args", "--dry-run=server")
    wait_rollouts(sh, t)
    stt_reachable(sh, t)
    step_keycloak(sh, t)
    step_plugin(sh, t)
    step_portal(sh, t)
    changed = step_jitsi(sh, t, args.yes)
    module_after = (sh.kjson("get", "configmap", "synascriber-prosody", ns=t["namespace"]) or {}).get("data")
    if not changed and module_before and module_before != module_after:
        sh.kubectl("rollout", "restart", f"statefulset/{t['jitsiRelease']}-prosody", ns=t["namespace"])
    step_opendesk_env(sh, t)
    t["jitsiValues"] = json.loads(sh.helm("get", "values", t["jitsiRelease"], "-o", "json", ns=t["namespace"]).stdout or "{}")
    problems = step_verify(sh, t)
    summary(sh, t)
    return 1 if problems else 0


def cmd_verify(sh, args):
    check_tools(sh)
    t = discover(sh)
    return 1 if step_verify(sh, t) else 0


def cmd_opendesk_env(sh, args):
    check_tools(sh)
    t = discover(sh)
    step_plugin_owner_only(sh, t)
    step_opendesk_env(sh, t)


def cmd_uninstall(sh, args):
    check_tools(sh)
    t = discover(sh)
    ns = t["namespace"]
    what = "meeting notes and Synaplan (with its database)" if args.all else "meeting notes (Synaplan stays)"
    if not ask(f"Remove {what} from {ns}?", args.yes):
        raise Stop("nothing changed")
    try:
        step_plugin_owner_only(sh, t)
    except Stop:
        t["ownerId"] = 0
    if sh.kjson("get", "secret", "synascriber", ns=ns):
        step_jitsi(sh, t, True, remove=True)
    step_keycloak(sh, t, remove=("synascriber", "synaplan") if args.all else ("synascriber",))
    if args.all:
        step_portal(sh, t, remove=True)
    state = write_state(sh, t, enabled=False)
    if args.all:
        helmfile(sh, state, "destroy")
        for kind, name in (("secret", "synaplan-mariadb"), ("secret", "synaplan-oidc-credentials"), ("secret", "synaplan-app-secret"),
                           ("secret", "synaplan-bootstrap-admin"), ("pvc", "data-synaplan-mariadb-0")):
            sh.kubectl("delete", kind, name, "--ignore-not-found", ns=ns)
    else:
        helmfile(sh, state, "apply", "--suppress-diff", "--diff-args", "--dry-run=server")
    sh.kubectl("delete", "secret", "synascriber", "--ignore-not-found", ns=ns)
    say("removed")
    ok(f"{what} removed from {ns}")
    note("Remove synascriber.yaml.gotmpl from your openDesk environment too, if you added it.")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=["check", "plan", "install", "verify", "opendesk-env", "uninstall"])
    parser.add_argument("--env", type=pathlib.Path, default=HERE / "synascriber.env")
    parser.add_argument("--yes", action="store_true")
    parser.add_argument("--all", action="store_true", help="uninstall: remove Synaplan and its database too")
    args = parser.parse_args()
    try:
        if not args.env.is_file() and args.command != "check":
            raise Stop(f"{args.env} not found", f"cp {HERE / 'synascriber.env.example'} {args.env}  and edit it.")
        sh = Shell(load_settings(args.env))
        flows = {"check": cmd_check, "plan": cmd_plan, "install": cmd_install, "verify": cmd_verify,
                 "opendesk-env": cmd_opendesk_env, "uninstall": cmd_uninstall}
        result = flows[args.command](sh, args)
        return result if isinstance(result, int) else 0
    except Stop as stop:
        print(f"\n   \033[31mstopped\033[0m  {stop}", file=sys.stderr)
        if stop.hint:
            print(re.sub(r"^", "            ", stop.hint.strip(), flags=re.M), file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("\n   interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
